#!/usr/bin/env python3
"""Run the currently staged Advent of Code level."""

from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent
LEVEL_DIR = ROOT / "levels" / "2016" / "02-2"
sys.path.insert(0, str(LEVEL_DIR))

from solution import code  # noqa: E402

DEFAULT_INPUT = ROOT / "inputs" / "2016" / "02.txt"


def main() -> int:
    input_path = Path(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_INPUT
    if not input_path.is_file():
        print(
            "Input pending: add inputs/2016/02.txt after Advent of Code access "
            "is available."
        )
        return 0

    try:
        answer = code(input_path.read_text(encoding="utf-8"))
    except ValueError as error:
        print(f"Invalid input: {error}", file=sys.stderr)
        return 2

    print(answer)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
